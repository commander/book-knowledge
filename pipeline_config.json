{
 "_note": "All pipeline settings. See docs/pipeline_design.md and docs/experiments.md. E6: transfer: 5 question forms for each fact (description to name, topic first, reworded with a copy check), joined questions from two facts of different units; traps off.",
 "experiment": "E6",
 "student": "Qwen/Qwen2.5-3B-Instruct",
 "seed": 1234,
 "stages": ["split", "facts", "data", "train", "save"],
 "split": {"min_words": 150, "max_words": 250},
 "teacher": {"model": "Qwen/Qwen2.5-7B-Instruct-AWQ", "max_model_len": 4096, "gpu_memory_utilization": 0.9},
 "facts": {"prompt": "facts.txt", "temperature": 0.2, "max_tokens": 1536, "retries": 1,
           "quote_min_share": 0.8, "max_per_unit": 12},
 "data": {"parts": ["fact_qa", "joined", "rewrites"],
          "fact_qa": {"prompt": "fact_questions.txt", "facts_per_call": 3, "pairs_per_fact": 5,
                      "copy_check_forms": [5], "copy_words": 5,
                      "temperature": 0.7, "max_tokens": 2048, "retries": 1},
          "joined": {"prompt": "joined_questions.txt", "facts_share": 0.5, "max_df": 0.02,
                     "pairs_per_call": 4, "temperature": 0.7, "max_tokens": 1024, "retries": 1},
          "traps": {"prompt": "traps.txt", "facts_share": 0.5, "twin_types": ["fact_q1", "fact_q2"],
                    "questions_per_call": 8, "max_word_diff": 4, "temperature": 0.7, "max_tokens": 1024,
                    "retries": 1},
          "rewrites": {"prompts": ["rewrite_explain.txt", "rewrite_points.txt"], "temperature": 0.7,
                       "max_tokens": 700, "min_words": 60},
          "baseline_qa": {"prompt": "baseline_qa.txt", "pairs_per_unit": 5, "temperature": 0.7,
                          "max_tokens": 1024}},
 "train": {"lora_rank": 64, "lora_alpha": 128, "lora_dropout": 0.05,
           "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
           "learning_rate": 0.0002, "lr_scheduler": "linear", "warmup_ratio": 0.0, "epochs": 3,
           "effective_batch_size": 16, "per_device_batch": 8, "length_grouping": true,
           "max_len": 512, "save_steps": 100},
 "replay": {"share": 0.0, "save_rows": 2000},
 "cap": {"gpu_hours": 5, "wall_hours": 10, "reserve_exam_minutes": 15, "enforce": true}
}
