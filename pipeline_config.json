{
 "_note": "All pipeline settings. See docs/pipeline_design.md and docs/experiments.md. E1: facts (stage 2) and 3 questions for each fact (3a), with the baseline training values and length-grouped batches.",
 "experiment": "E1",
 "student": "Qwen/Qwen2.5-3B-Instruct",
 "seed": 1234,
 "stages": ["split", "facts", "data", "train", "save"],
 "split": {"min_words": 150, "max_words": 250},
 "teacher": {"model": "Qwen/Qwen2.5-7B-Instruct-AWQ", "max_model_len": 4096, "gpu_memory_utilization": 0.9},
 "facts": {"prompt": "facts.txt", "temperature": 0.2, "max_tokens": 1536, "retries": 1,
           "quote_min_share": 0.8, "max_per_unit": 12},
 "data": {"mode": "fact_qa", "prompt": "fact_questions.txt", "facts_per_call": 4,
          "temperature": 0.7, "max_tokens": 1536, "retries": 1},
 "train": {"lora_rank": 16, "lora_alpha": 32, "lora_dropout": 0.05,
           "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
           "learning_rate": 0.0002, "lr_scheduler": "linear", "warmup_ratio": 0.0, "epochs": 3,
           "effective_batch_size": 16, "per_device_batch": 16, "length_grouping": true,
           "max_len": 512, "save_steps": 100},
 "replay": {"share": 0.0, "save_rows": 2000},
 "cap": {"gpu_hours": 5, "wall_hours": 10, "reserve_exam_minutes": 15, "enforce": true}
}
